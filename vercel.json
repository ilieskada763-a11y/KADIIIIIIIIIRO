{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/src/main.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "backend/src/main.ts": {
      "runtime": "vercel-node@latest"
    }
  }
}
